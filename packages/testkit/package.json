{
    "name": "@tiles-town/testkit",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "clean": "pnpm exec rimraf dist",
        "build": "pnpm --filter @tiles-town/game-core run build:deps && pnpm run clean && tsc --project tsconfig.json",
        "lint": "pnpm exec eslint src --ext ts",
        "lint:fix": "pnpm exec eslint src --ext ts --fix",
        "typecheck": "pnpm --filter @tiles-town/game-core run build:deps && tsc --project tsconfig.json --noEmit",
        "test": "echo \"No standalone tests for testkit\""
    },
    "dependencies": {
        "@tiles-town/game-core": "workspace:*"
    },
    "devDependencies": {
        "rimraf": "^6.1.3",
        "typescript": "^6.0.2"
    }
}
