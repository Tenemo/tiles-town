{
    "name": "@tiles-town/game-core",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "clean": "pnpm exec rimraf dist",
        "build": "pnpm run clean && tsc --project tsconfig.json",
        "build:deps": "tsc --project tsconfig.json",
        "eslint": "pnpm --dir ../.. exec eslint packages/game-core/src packages/game-core/vitest.config.ts",
        "eslint:fix": "pnpm --dir ../.. exec eslint packages/game-core/src packages/game-core/vitest.config.ts --fix",
        "lint": "pnpm run eslint",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
