{
    "name": "@tiles-town/web",
    "version": "3.0.0",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MIT",
    "description": "React, Redux, Vitest, Vite, TypeScript, ESLint and @typescript-eslint",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/tiles-town.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/tiles-town/issues"
    },
    "homepage": "https://github.com/Tenemo/tiles-town#readme",
    "scripts": {
        "dev": "pnpm --filter @tiles-town/contracts run build && vite",
        "start": "pnpm --filter @tiles-town/contracts run build && vite",
        "build": "pnpm --filter @tiles-town/contracts run build && tsc --noEmit && vite build",
        "preview": "vite preview",
        "eslint": "eslint src config vite.config.ts --ext js,jsx,ts,tsx",
        "eslint:fix": "eslint src config vite.config.ts --ext js,jsx,ts,tsx --fix",
        "stylelint": "stylelint **/*.scss **/*.css",
        "lint": "pnpm run eslint && pnpm run stylelint",
        "tsc": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "pnpm --filter @tiles-town/contracts run build && vitest run",
        "test:update": "vitest run --update",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "browserslist": [
        "> 0.5%",
        "not dead",
        "not IE > 0",
        "not op_mini all"
    ],
    "engines": {
        "node": ">=24.14.1 <25"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-regular-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/react-fontawesome": "^3.3.0",
        "@sentry/react": "^10.47.0",
        "@sentry/tracing": "^7.120.4",
        "@tiles-town/contracts": "workspace:*",
        "axios": "^1.14.0",
        "bootstrap": "^5.3.8",
        "core-js": "^3.49.0",
        "date-fns": "^4.1.0",
        "history": "^5.3.0",
        "normalize.css": "^8.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-helmet-async": "^3.0.0",
        "react-redux": "^9.2.0",
        "react-router": "^7.14.0",
        "react-router-dom": "^7.14.0",
        "react-spinners": "^0.17.0",
        "react-toastify": "^11.0.5",
        "redux": "^5.0.1",
        "redux-first-history": "^5.2.0",
        "redux-persist": "^6.0.0",
        "redux-thunk": "^3.1.0",
        "reselect": "^5.1.1"
    },
    "devDependencies": {
        "@redux-devtools/extension": "^4.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/circular-dependency-plugin": "^5.0.8",
        "@types/core-js": "^2.5.8",
        "@types/eslint": "^9.6.1",
        "@types/eslint-plugin-prettier": "^3.1.3",
        "@types/history": "^5.0.0",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^25.5.2",
        "@types/prettier": "^3.0.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/react-redux": "^7.1.34",
        "@types/redux-logger": "^3.0.13",
        "@types/redux-mock-store": "^1.5.0",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.2",
        "@vitest/ui": "^4.1.2",
        "eslint": "^8.57.1",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.15.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "immutable": "^5.1.5",
        "jsdom": "^29.0.1",
        "postcss-html": "^1.8.1",
        "prettier": "^3.8.1",
        "prettier-eslint": "^16.4.2",
        "prettier-stylelint": "^0.4.2",
        "redux-logger": "^3.0.6",
        "redux-mock-store": "^1.5.5",
        "rimraf": "^6.1.3",
        "sass-embedded": "^1.99.0",
        "stylelint": "^17.6.0",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-recommended-scss": "^17.0.0",
        "stylelint-scss": "^7.0.0",
        "sugarss": "^5.0.1",
        "typescript": "^6.0.2",
        "vite": "^8.0.5",
        "vitest": "^4.1.2"
    }
}
