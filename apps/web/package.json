{
    "name": "@tiles-town/web",
    "version": "3.0.0",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MIT",
    "description": "React, Redux, Vitest, Vite, TypeScript, ESLint and @typescript-eslint",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/tiles-town.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/tiles-town/issues"
    },
    "homepage": "https://github.com/Tenemo/tiles-town#readme",
    "scripts": {
        "dev": "pnpm --filter @tiles-town/contracts run build && vite",
        "start": "pnpm --filter @tiles-town/contracts run build && vite",
        "build": "pnpm --filter @tiles-town/contracts run build && tsc --noEmit && vite build",
        "preview": "vite preview",
        "eslint": "eslint . --ext js,jsx,ts,tsx",
        "eslint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
        "stylelint": "stylelint **/*.scss **/*.css",
        "lint": "pnpm run eslint && pnpm run stylelint",
        "tsc": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "pnpm --filter @tiles-town/contracts run build && vitest run",
        "test:update": "vitest run --update",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "browserslist": [
        "> 0.5%",
        "not dead",
        "not IE > 0",
        "not op_mini all"
    ],
    "engines": {
        "node": ">=24.14.1 <25"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.3.0",
        "@fortawesome/fontawesome-svg-core": "^6.3.0",
        "@fortawesome/free-brands-svg-icons": "^6.3.0",
        "@fortawesome/free-regular-svg-icons": "^6.3.0",
        "@fortawesome/free-solid-svg-icons": "^6.3.0",
        "@fortawesome/react-fontawesome": "^0.2.0",
        "@sentry/react": "^7.44.2",
        "@sentry/tracing": "^7.44.2",
        "@tiles-town/contracts": "workspace:*",
        "axios": "^1.3.4",
        "bootstrap": "^5.3.0-alpha1",
        "core-js": "^3.29.1",
        "date-fns": "^2.29.3",
        "history": "^5.3.0",
        "normalize.css": "^8.0.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^1.3.0",
        "react-redux": "^8.0.5",
        "react-router": "^6.9.0",
        "react-router-dom": "^6.9.0",
        "react-spinners": "^0.13.8",
        "react-toastify": "^9.1.2",
        "redux": "^4.2.1",
        "redux-first-history": "^5.1.1",
        "redux-persist": "^6.0.0",
        "redux-thunk": "^2.4.2",
        "reselect": "^4.1.7"
    },
    "devDependencies": {
        "@redux-devtools/extension": "^3.2.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^14.0.0",
        "@types/circular-dependency-plugin": "^5.0.5",
        "@types/core-js": "^2.5.5",
        "@types/eslint": "^8.21.3",
        "@types/eslint-plugin-prettier": "^3.1.0",
        "@types/history": "^4.7.11",
        "@types/jsdom": "^21.1.1",
        "@types/node": "^24.0.0",
        "@types/prettier": "^2.7.2",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@types/react-redux": "^7.1.25",
        "@types/redux-logger": "^3.0.12",
        "@types/redux-mock-store": "^1.0.3",
        "@typescript-eslint/eslint-plugin": "^5.56.0",
        "@typescript-eslint/parser": "^5.56.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.2",
        "@vitest/ui": "^4.1.2",
        "eslint": "^8.36.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.8.0",
        "eslint-import-resolver-typescript": "^3.5.3",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-jest": "^27.2.1",
        "eslint-plugin-jsx-a11y": "^6.7.1",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "4.6.0",
        "immutable": "^4.3.0",
        "jsdom": "^21.1.2",
        "postcss-html": "^1.5.0",
        "prettier": "^2.8.6",
        "prettier-eslint": "^15.0.1",
        "prettier-stylelint": "^0.4.2",
        "redux-logger": "^3.0.6",
        "redux-mock-store": "^1.5.4",
        "rimraf": "^4.4.1",
        "sass-embedded": "^1.99.0",
        "stylelint": "^15.3.0",
        "stylelint-config-recommended": "^10.0.1",
        "stylelint-config-recommended-scss": "^9.0.1",
        "stylelint-scss": "^4.5.0",
        "sugarss": "^5.0.0",
        "typescript": "^5.0.2",
        "vite": "^8.0.5",
        "vitest": "^4.1.2"
    }
}
