{
    "name": "@tiles-town/web",
    "version": "3.0.0",
    "author": "Piotr Piech <piotr@piech.dev>",
    "license": "MIT",
    "description": "React, Redux, Vitest, Vite, TypeScript, ESLint and @typescript-eslint",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/tiles-town.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/tiles-town/issues"
    },
    "homepage": "https://github.com/Tenemo/tiles-town#readme",
    "scripts": {
        "dev": "pnpm --filter @tiles-town/contracts run build:deps && vite",
        "start": "pnpm --filter @tiles-town/contracts run build:deps && vite",
        "build": "pnpm --filter @tiles-town/contracts run build:deps && tsc --noEmit && vite build",
        "clean": "pnpm exec rimraf dist",
        "preview": "vite preview",
        "eslint": "pnpm --dir ../.. exec eslint apps/web/src apps/web/config apps/web/vite.config.ts",
        "eslint:fix": "pnpm --dir ../.. exec eslint apps/web/src apps/web/config apps/web/vite.config.ts --fix",
        "stylelint": "stylelint **/*.scss **/*.css",
        "stylelint:fix": "stylelint **/*.scss **/*.css --fix",
        "lint": "pnpm run eslint && pnpm run stylelint",
        "tsc": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "pnpm --filter @tiles-town/contracts run build:deps && vitest run",
        "test:update": "vitest run --update",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "browserslist": [
        "> 0.5%",
        "not dead",
        "not IE > 0",
        "not op_mini all"
    ],
    "engines": {
        "node": ">=24.14.1 <25"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/react-fontawesome": "^3.3.0",
        "@sentry/react": "^10.47.0",
        "@reduxjs/toolkit": "^2.11.0",
        "@tiles-town/contracts": "workspace:*",
        "@tiles-town/game-core": "workspace:*",
        "axios": "^1.14.0",
        "bootstrap": "^5.3.8",
        "normalize.css": "^8.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-helmet-async": "^3.0.0",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.14.0",
        "react-toastify": "^11.0.5"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^25.5.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.2",
        "@vitest/ui": "^4.1.2",
        "jsdom": "^29.0.1",
        "postcss-html": "^1.8.1",
        "rimraf": "^6.1.3",
        "sass-embedded": "^1.99.0",
        "stylelint": "^17.6.0",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-recommended-scss": "^17.0.0",
        "stylelint-scss": "^7.0.0",
        "sugarss": "^5.0.1",
        "typescript": "^6.0.2",
        "vite": "^8.0.5",
        "vitest": "^4.1.2"
    }
}
