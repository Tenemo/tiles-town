{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": "./src/",
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["vite/client", "vitest/globals"],
        "removeComments": true,
        "declaration": false,
        "sourceMap": true,
        "allowJs": true,
        "noEmit": true,
        "paths": {
            "@tiles-town/contracts": ["../../packages/contracts/src/index.ts"]
        }
    },
    "include": [
        "src/**/*",
        "config/**/*",
        ".eslintrc.js",
        "vite.config.ts"
    ],
    "exclude": ["**/*.snap"]
}
