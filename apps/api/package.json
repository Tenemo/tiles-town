{
    "name": "@tiles-town/api",
    "version": "2.0.0",
    "description": "Backend for tiles.town",
    "author": "piotr@piech.dev",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tenemo/tiles-town.git"
    },
    "bugs": {
        "url": "https://github.com/Tenemo/tiles-town/issues"
    },
    "homepage": "https://github.com/Tenemo/tiles-town#readme",
    "engines": {
        "node": ">=24.14.1 <25"
    },
    "scripts": {
        "start": "node dist/start-server.js",
        "build": "pnpm run cleanDist && cross-env NODE_ENV=production babel --extensions '.ts' src --out-dir dist",
        "cleanDist": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.mkdirSync('dist',{recursive:true});\"",
        "db:migrate": "ts-node --transpile-only src/scripts/migrate-db.ts",
        "db:migrate:dist": "node dist/scripts/migrate-db.js",
        "dev": "pnpm run db:migrate && nodemon",
        "nodemon": "nodemon",
        "dev:ts": "ts-node --transpile-only src/start-server.ts",
        "eslint": "eslint src test vitest.config.ts --ext js,ts",
        "eslint:fix": "eslint src test vitest.config.ts --ext js,ts --fix",
        "lint": "pnpm run eslint",
        "tsc": "tsc",
        "typecheck": "pnpm run tsc",
        "test": "pnpm --filter @tiles-town/contracts run build && cross-env NODE_ENV=test vitest run --reporter verbose",
        "test:coverage": "pnpm run test -- --coverage",
        "test:watch": "cross-env NODE_ENV=test vitest"
    },
    "dependencies": {
        "@sentry/node": "^10.47.0",
        "@sentry/tracing": "^7.120.4",
        "@sinclair/typebox": "^0.34.49",
        "@tiles-town/contracts": "workspace:*",
        "body-parser": "^2.2.2",
        "cookie-parser": "^1.4.7",
        "core-js": "^3.49.0",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-winston": "^4.2.0",
        "http-errors": "^2.0.1",
        "http-status": "^2.1.0",
        "joi": "^18.1.2",
        "lodash": "^4.18.1",
        "md5": "^2.3.0",
        "morgan": "^1.10.1",
        "parse-database-url": "^0.3.0",
        "pg": "^8.20.0",
        "pg-hstore": "^2.3.4",
        "seedrandom": "^3.0.5",
        "sequelize": "^6.37.8",
        "umzug": "^3.8.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.6",
        "@babel/core": "^7.29.0",
        "@babel/node": "^7.29.0",
        "@babel/preset-env": "^7.29.2",
        "@babel/preset-typescript": "^7.28.5",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/eslint": "^9.6.1",
        "@types/eslint-plugin-prettier": "^3.1.3",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/lodash": "^4.17.24",
        "@types/md5": "^2.3.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^25.5.2",
        "@types/npm": "^7.19.3",
        "@types/prettier": "^3.0.0",
        "@types/seedrandom": "^3.0.8",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-babel-module": "^5.3.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-sql": "^3.4.1",
        "nodemon": "^3.1.14",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
