{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": "./src/",
        "module": "commonjs",
        "moduleResolution": "node",
        "removeComments": true,
        "declaration": false,
        "sourceMap": true,
        "allowJs": true,
        "noEmit": true,
        "noErrorTruncation": true,
        "types": ["node", "vitest/globals"],
        "paths": {
            "@tiles-town/contracts": ["../../packages/contracts/src/index.ts"]
        }
    },
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    },
    "include": [
        "src/**/*",
        "test/**/*",
        "config/**/*",
        ".eslintrc.js",
        "temp/**/*",
        "vitest.config.ts"
    ]
}
