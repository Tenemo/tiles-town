{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "removeComments": true,
        "declaration": false,
        "sourceMap": true,
        "allowJs": true,
        "noEmit": true,
        "noErrorTruncation": true,
        "types": ["node", "vitest/globals"],
        "paths": {
            "@tiles-town/contracts": ["../../packages/contracts/src/index.ts"],
            "config": ["./src/config.ts"],
            "controllers/*": ["./src/controllers/*"],
            "database": ["./src/database.ts"],
            "logging": ["./src/logging.ts"],
            "models/*": ["./src/models/*"],
            "routes/*": ["./src/routes/*"],
            "services/*": ["./src/services/*"],
            "utils/*": ["./src/utils/*"]
        }
    },
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    },
    "include": [
        "src/**/*",
        "test/**/*",
        "config/**/*",
        ".eslintrc.js",
        "temp/**/*",
        "vitest.config.ts"
    ]
}
